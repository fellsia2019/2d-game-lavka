{
  "name": "lavka-u-morya",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "build": "tsc --noEmit && npm run content:plan && npm run content:check && vite build && node scripts/check-size.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "npm run build && playwright test",
    "content:check": "tsx scripts/check-content.ts",
    "content:plan": "node scripts/check-content-plan.mjs",
    "content:produce-shop": "tsx scripts/produce-shop-expansion.ts",
    "content:audit": "tsx scripts/audit-generator.ts",
    "content:produce-stage-block": "tsx scripts/produce-stage-block.ts",
    "content:produce-bakery": "tsx scripts/produce-bakery.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.2"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  }
}
